{
    "name": "thofman/knowledge-base",
    "description": "Knowledge base of talks/blogposts",
    "type": "library",
    "config": {
        "sort-packages": true,
        "policy": {
            "cooldown": {
                "period": "1 week"
            }
        },
        "allow-plugins": {
            "captainhook/captainhook-phar": true,
            "captainhook/hook-installer": true
        }
    },
    "require": {
        "php": "^8.5",
        "spatie/yaml-front-matter": "^2.1",
        "symfony/console": "^8.1"
    },
    "require-dev": {
        "captainhook/captainhook-phar": "^5.29",
        "captainhook/hook-installer": "^1.0",
        "phpstan/phpstan": "^2.3",
        "phpunit/phpunit": "^13.4",
        "ramsey/conventional-commits": "^1.7",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "thofman\\KnowledgeBase\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "thofman\\KnowledgeBase\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable"
}
